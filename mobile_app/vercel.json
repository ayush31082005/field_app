{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://field-app-server.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://field-app-server.vercel.app/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
